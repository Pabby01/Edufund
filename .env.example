# EduFund Environment Variables

# Supabase (pre-configured automatically by Bolt)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cowrywise Embed API (server-side only — DO NOT use NEXT_PUBLIC)
# Obtain from https://developers.cowrywise.com/
# Leave empty to show honest "integration pending" state
COWRYWISE_API_KEY=
COWRYWISE_API_SECRET=
COWRYWISE_WEBHOOK_SECRET=

# Admin configuration (optional — set in Supabase dashboard)
# To grant admin access: UPDATE profiles SET is_admin = true WHERE id = 'UUID';
